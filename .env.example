# --- Secrets ---
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Per-provider LLM keys. Each agent picks its provider in the Agent Settings
# screen and reads that provider's key from here (not needed for ollama/vllm).
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY is still honoured for the default provider in config.yaml.
# LLM_API_KEY=

# --- Optional overrides ---
# Uncomment to use Postgres instead of the SQLite default
# DATABASE_URL=postgresql+psycopg://ragkit:ragkit@localhost:5432/ragkit

# Qdrant (only if secured)
# VECTORSTORE_API_KEY=

# Embedding provider credentials (only if used)
# EMBEDDING_API_KEY=

# Bootstrap admin password (used on first run if no users exist)
INITIAL_ADMIN_PASSWORD=maple.forest9

# --- S3 storage (only when storage.kind = s3 in config.yaml) ---
# Credentials: set these OR rely on IAM role / ~/.aws/credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=my-ragkit-bucket
# S3_ENDPOINT_URL=          # For MinIO: http://localhost:9000

# Shared token the MCP adapter uses to talk to the REST server
MCP_SERVICE_TOKEN=change-me-mcp-service-token

# Bearer token of the demo maintenance MCP server (server/demo/maintenance_mcp.py).
# Agents reach MCP servers with tokens from MCP_TOKEN_* variables only.
MCP_TOKEN_MAINTENANCE=demo-maintenance-token
