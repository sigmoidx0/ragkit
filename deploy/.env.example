# Copy to deploy/.env. Read by the server container.

JWT_SECRET_KEY=replace-with-a-long-random-string   # openssl rand -hex 32
INITIAL_ADMIN_PASSWORD=replace-me                  # first admin: admin@example.com (admin_bootstrap.email in config.yaml)
POSTGRES_PASSWORD=replace-me

# ── Chat model ── choose one ───────────────────────────────────────────────
# (a) Ollama inside the stack: start with `--profile ollama` (default address)
# OLLAMA_CHAT_MODEL=qwen2.5:14b
# (b) Ollama on the host machine:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# (c) A hosted provider as the default (agents can still pick their own):
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.5-flash
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# WEB_PORT=8080
