@startuml Document Create

title POST /services/{service_id}/documents — 문서 업로드 & 인덱싱

actor Client
participant "FastAPI\n(documents.py)" as API
participant "services/\ndocuments.py" as SVC
participant "Storage\n(get_storage())" as FS
participant "loaders.py\n(ingest)" as LDR
participant "indexing.py" as IDX
participant "chunking.py\n(ingest)" as ING
participant "Embedder" as EMB
participant "VectorStore" as QD
database "SQLite/PG\n(DB)" as DB

Client -> API : POST /services/{service_id}/documents\n(file, title, description, chunk_config?)
activate API

API -> DB : INSERT Document\n(status=pending, file_path="", chunk_config=parsed)
activate DB
DB --> API : document.id
deactivate DB

API -> SVC : save_document_file(document, file, filename, content_type)
activate SVC
SVC -> FS : storage.save_document_file(document_id, filename, source)
activate FS
note right of FS
  SHA-256 계산
  documents/{id}/{safe_filename} 저장
end note
FS --> SVC : StoredFile(stored_path, size_bytes, sha256)
deactivate FS
note right of SVC
  document 필드 직접 업데이트
  (source_filename, mime_type,
   file_path, size_bytes, sha256)
end note
deactivate SVC

API -> DB : flush

API -> FS : storage.as_local_path(file_path)
activate FS
FS --> API : local path (context manager)
deactivate FS

API -> LDR : convert_to_documents(local_path)
activate LDR
note right of LDR
  확장자 기반 로더 선택
  (PDF→PyMuPDF, Office→Unstructured, txt→plain)
end note
LDR --> API : list[Document]
deactivate LDR

alt 파일 변환 실패
  API -> SVC : delete_document_dir(document_id)
  API --> Client : 422 conversion failed
end

API -> IDX : index_document(db, document, docs)
activate IDX

IDX -> DB : flush (status=chunking)

IDX -> ING : chunk_strategy_from_config(chunk_config).split(docs)
activate ING
note right of ING
  chunk_config 기반 전략 선택
  (기본값: RecursiveChunkStrategy)
end note
ING --> IDX : list[ChunkRecord]
deactivate ING

IDX -> DB : flush (status=embedding)

IDX -> EMB : embed_documents(texts)
activate EMB
EMB --> IDX : list[vector]
deactivate EMB

IDX -> QD : upsert(point_ids, vectors, payloads)
activate QD
note right of QD
  payload: document_id, service_id,
           ordinal, text, source_metadata
end note
QD --> IDX : ok
deactivate QD

IDX -> DB : flush (status=indexed, embedding_model=...)

alt 인덱싱 중 예외 발생
  IDX -> QD : delete_points(inserted_point_ids)
  IDX --> API : raise RuntimeError
  API -> SVC : delete_document_dir(document_id)
  API --> Client : 500 indexing failed
end

deactivate IDX

API -> DB : COMMIT (TxDbDep)
activate DB
DB --> API : ok
deactivate DB

API --> Client : 201 DocumentOut

deactivate API

@enduml

newpage

@startuml Document Replace

title POST /services/{service_id}/documents/{id}/replace — 문서 교체

actor Client
participant "FastAPI\n(documents.py)" as API
participant "services/\ndocuments.py" as SVC
participant "Storage\n(get_storage())" as FS
participant "loaders.py\n(ingest)" as LDR
participant "indexing.py" as IDX
participant "VectorStore" as QD
database "SQLite/PG\n(DB)" as DB

Client -> API : POST /services/{service_id}/documents/{id}/replace\n(file, chunk_config?)
activate API

API -> DB : GET Document by id
DB --> API : document

API -> IDX : clear_document_index(document)
activate IDX
IDX -> QD : delete_document(document_id)\n[payload filter]
QD --> IDX : ok
deactivate IDX

API -> SVC : delete_document_dir(document_id)
activate SVC
SVC -> FS : storage.delete_document_dir(document_id)
note right of FS #pink
  ⚠ 여기서 실패하면 구 벡터는 삭제됐으나
  구 파일은 남는 불일치 발생 가능
end note
FS --> SVC : ok
deactivate SVC

API -> SVC : save_document_file(document, new_file, filename, content_type)
activate SVC
SVC -> FS : storage.save_document_file(document_id, filename, source)
FS --> SVC : StoredFile
note right of SVC
  document 필드 직접 업데이트
  (file_path, sha256, size_bytes 등)
end note
deactivate SVC

API -> DB : flush (status=pending, error=None, chunk_config=parsed)

API -> FS : storage.as_local_path(file_path)
activate FS
FS --> API : local path (context manager)
deactivate FS

API -> LDR : convert_to_documents(local_path)
activate LDR
LDR --> API : list[Document]
deactivate LDR

alt 파일 변환 실패
  API --> Client : 422 conversion failed
end

API -> IDX : index_document(db, document, docs)
activate IDX
IDX --> API : (status=indexed, embedding_model=...)
deactivate IDX

API -> DB : COMMIT

API --> Client : 200 DocumentOut

deactivate API

@enduml

